---
// Sticky bottom CTA, all devices. Appears once the primary buy panel
// (#primary-buy-panel) is out of view, disappears once it's back in view.
//
// On desktop the primary panel is itself sticky within its grid row (the
// intro section — delay-cost, what's-in-the-kit, income cap), so this bar
// stays hidden through all of that. But that grid row ends roughly a third
// of the way down the page — for everything after (PDF preview, testimonials,
// comparison table, the bank-refusal story, denial reasons, FAQ) desktop
// previously had NO persistent buy affordance at all once the aside scrolled
// out of its containing row. This used to be `md:!hidden` on the assumption
// "desktop already has a sticky aside" — true for the first third of the
// page, not the rest of it. Mobile has no sticky aside at all (the grid
// collapses to a single stacked column below `md`, so the panel is just a
// static block buried after the intro content) — this bar has always been
// its only persistent CTA.
//
// Click behavior: scroll back to the primary buy panel so the user
// confirms the consent checkbox there. We deliberately do NOT include
// a second consent checkbox in the sticky bar — Rule 4 requires one
// canonical consent surface and we don't want two checkboxes drifting
// out of sync.

interface Props {
  stateName: string;
  price: number;
  agencyAbbreviation: string;
  // 'legal-guide' states (e.g. Florida) are never branded "Kit" — see
  // config.ts's productModel comment.
  legalGuide?: boolean;
}

const { stateName, price, agencyAbbreviation, legalGuide = false } = Astro.props;
const productNoun = legalGuide ? 'guide' : 'kit';
const ProductNoun = legalGuide ? 'Guide' : 'Kit';
---

<div
  id="sticky-buy-bar"
  class="no-print fixed bottom-0 left-0 right-0 z-40 hidden translate-y-full transform border-t border-border bg-surface-elevated shadow-lg transition-transform duration-200 ease-out"
  role="region"
  aria-label={`${stateName} ${productNoun} — sticky purchase bar`}
  data-visible="false"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
    <div class="min-w-0">
      <p class="truncate text-sm font-semibold text-ink-heading">
        {stateName} {ProductNoun} — <span class="text-primary">${price}</span>
      </p>
      <p class="truncate text-xs text-ink-muted">
        Instant download &middot; Refund if {agencyAbbreviation} rejects
      </p>
    </div>
    <a
      href="#primary-buy-panel"
      class="flex-shrink-0 rounded-full bg-cta px-4 py-2.5 text-sm font-semibold text-white no-underline hover:bg-cta-hover"
      data-sticky-cta-link
    >
      Get the {productNoun}
    </a>
  </div>
</div>

<script>
  // Show the sticky bar only after the primary buy panel scrolls out of
  // view. IntersectionObserver gives us this cheaply, with no scroll handler.
  const bar = document.getElementById('sticky-buy-bar');
  const target = document.getElementById('primary-buy-panel');
  if (bar && target) {
    // Default state: hidden, translated off-screen.
    bar.classList.remove('hidden');
    // Now that this bar can be visible on desktop too, it can coincide with
    // the bottom-right lead-capture slide-in. Publish its height as a CSS var
    // so that surface can offset above it instead of overlapping — see
    // LeadCaptureSlideIn.astro's sm:bottom-[calc(...)]. Falls back to 0px
    // (via the var()'s default) on any page without this bar at all.
    const setVisible = (visible: boolean) => {
      if (visible) {
        bar.dataset.visible = 'true';
        bar.classList.remove('translate-y-full');
        document.documentElement.style.setProperty('--mtg-sticky-bar-h', `${bar.offsetHeight}px`);
      } else {
        bar.dataset.visible = 'false';
        bar.classList.add('translate-y-full');
        document.documentElement.style.setProperty('--mtg-sticky-bar-h', '0px');
      }
    };
    setVisible(false);

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          // Show the sticky bar when the primary buy panel is OUT of view.
          setVisible(!entry.isIntersecting);
        }
      },
      { rootMargin: '0px 0px -20% 0px', threshold: 0 }
    );
    io.observe(target);

    // Smooth-scroll the in-page anchor and put focus on the consent checkbox
    // so a tap on the sticky CTA actually moves the user to the next action.
    const link = bar.querySelector<HTMLAnchorElement>('[data-sticky-cta-link]');
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      // Defer focus until the scroll animation settles.
      window.setTimeout(() => {
        const checkbox = target.querySelector<HTMLInputElement>('input[type="checkbox"][name="consent"]');
        checkbox?.focus({ preventScroll: true });
      }, 450);
    });
  }
</script>
